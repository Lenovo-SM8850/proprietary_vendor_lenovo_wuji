on init && property:ro.boot.product.vendor.sku=sun
    enable vendor.keymint-spu-qti

on init && property:ro.vendor.board.family=f-canoe && property:ro.vendor.qti.soc_name=canoe
    enable vendor.keymint-spu-qti

on init && property:ro.vendor.board.family=f-canoe && property:ro.vendor.qti.soc_name=whale
    enable vendor.keymint-spu-qti

service vendor.keymint-spu-qti /vendor/bin/hw/android.hardware.security.keymint-service-spu-qti
    disabled
    class early_hal
    user system
    group system drmrpc
