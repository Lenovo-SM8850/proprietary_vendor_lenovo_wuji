service vendor.fingerprint-gf /vendor/bin/hw/android.hardware.biometrics.fingerprint-service.gfcap
    user system
    group system input uhid
    capabilities WAKE_ALARM
    class hal
    interface aidl android.hardware.biometrics.fingerprint.IFingerprint/default
    interface aidl vendor.goodix.hardware.biometrics.fingerprint.cap.IGoodixFingerprintDaemon/default

on boot
	chmod 0660 /dev/tzdev
	chmod 0660 /dev/goodix_fp
	chown system system /dev/goodix_fp
    chown system system /sys/devices/platform/soc/11013000.spi3/spi_master/spi3/spi3.0/irq
    chmod 0660 /sys/devices/platform/soc/11013000.spi3/spi_master/spi3/spi3.0/irq
    chown system system /sys/devices/platform/soc/11013000.spi3/spi_master/spi3/spi3.0/hw_reset
    chmod 0660 /sys/devices/platform/soc/11013000.spi3/spi_master/spi3/spi3.0/hw_reset
    chown system system /sys/devices/platform/soc/11013000.spi3/spi_master/spi3/spi3.0/compatible_all
    chmod 0660 /sys/devices/platform/soc/11013000.spi3/spi_master/spi3/spi3.0/compatible_all
    chown system system /sys/devices/platform/soc/11013000.spi3/spi_master/spi3/spi3.0/clk_enable
    chmod 0660 /sys/devices/platform/soc/11013000.spi3/spi_master/spi3/spi3.0/clk_enable
    chown system system /sys/devices/platform/soc/11013000.spi3/spi_master/spi3/spi3.0/wakeup_enable
    chmod 0660 /sys/devices/platform/soc/11013000.spi3/spi_master/spi3/spi3.0/wakeup_enable

