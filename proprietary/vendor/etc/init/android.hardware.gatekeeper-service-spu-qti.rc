on init
    exec u:r:vendor_init-qti-keymaster-sh:s0 -- /vendor/bin/init.qti.keymaster.sh

service vendor.gatekeeper_spu /vendor/bin/hw/android.hardware.gatekeeper-service-spu-qti
    class early_hal
    user system
    group system
    disabled

on property:vendor.gatekeeper.is_security_level_spu=1 && property:ro.vendor.board.family=f-canoe && property:ro.vendor.qti.soc_name=canoe
    enable vendor.gatekeeper_spu

on property:vendor.gatekeeper.is_security_level_spu=1 && property:ro.vendor.board.family=f-canoe && property:ro.vendor.qti.soc_name=whale
    enable vendor.gatekeeper_spu