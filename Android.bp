    stem: "vendor.qti.ImsRtpService-V2-ndk",
    owner: "lenovo",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: [
                "proprietary/system_ext/lib64/vendor.qti.ImsRtpService-V2-ndk.so",
            ],
            shared_libs: [
                "libbinder_ndk",
                "android.hardware.common-V2-ndk",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "64",
    prefer: true,
    system_ext_specific: true,
}

